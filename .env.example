# Machinarchy Agent configuration.
# Copy to a protected environment file; never commit actual credentials.

MACHINARCHY_ENVIRONMENT=development
MACHINARCHY_LOG_LEVEL=info
MACHINARCHY_AGENT_NAME=machinarchy-agent
MACHINARCHY_AGENT_VERSION=dev

# NATS endpoints. In production use tls:// and configure authentication.
MACHINARCHY_AGENT_NATS_URL=nats://127.0.0.1:4222
# Choose exactly one authentication method when authentication is enabled:
# MACHINARCHY_AGENT_NATS_CREDENTIALS_FILE=/etc/machinarchy-agent/nats.creds
# MACHINARCHY_AGENT_NATS_TOKEN=
# MACHINARCHY_AGENT_NATS_USERNAME=
# MACHINARCHY_AGENT_NATS_PASSWORD=

# One-time enrollment token. Remove it after successful enrollment.
MACHINARCHY_AGENT_ENROLLMENT_TOKEN=
MACHINARCHY_AGENT_STATE_FILE=./data/agent/identity.json
# Defaults to the identity path plus .operations.json; keep the directory private.
# MACHINARCHY_AGENT_OPERATION_STORE_FILE=./data/agent/operations.json

MACHINARCHY_AGENT_CONNECT_TIMEOUT=5s
MACHINARCHY_AGENT_STARTUP_TIMEOUT=30s
MACHINARCHY_AGENT_RECONNECT_WAIT=2s
MACHINARCHY_AGENT_RECONNECT_JITTER=500ms
MACHINARCHY_AGENT_DRAIN_TIMEOUT=10s
MACHINARCHY_AGENT_REQUEST_TIMEOUT=5s
MACHINARCHY_AGENT_EVENT_BUFFER_SIZE=64
# Controller must provision this JetStream stream and durable per-Agent consumer.
MACHINARCHY_AGENT_JETSTREAM_STREAM=MACHINARCHY_AGENT_EVENTS
MACHINARCHY_AGENT_EVENT_NAK_DELAY=5s

MACHINARCHY_AGENT_OPERATION_WORKERS=4
MACHINARCHY_AGENT_OPERATION_QUEUE_SIZE=64
MACHINARCHY_AGENT_OPERATION_TIMEOUT=5m
MACHINARCHY_AGENT_OPERATION_MAX_INPUT_BYTES=65536
MACHINARCHY_AGENT_OPERATION_MAX_OUTPUT_BYTES=262144
MACHINARCHY_AGENT_RESULT_PUBLISH_TIMEOUT=5s

# Optional advanced overrides. Keep these aligned with machinarchy-protocol.
# MACHINARCHY_AGENT_REGISTER_SUBJECT=machinarchy.v1.agent.register
# MACHINARCHY_AGENT_LEASE_RENEW_SUBJECT=machinarchy.v1.agent.lease.renew

# Service management is opt-in and limited to exact systemd unit names.
# Status is read-only. Lifecycle actions require a separate explicit opt-in.
# The Agent does not use sudo or elevate privileges; systemd applies OS policy.
MACHINARCHY_AGENT_SERVICE_MANAGEMENT_ENABLED=false
MACHINARCHY_AGENT_SERVICE_CONTROL_ENABLED=false
# Required when service management is enabled. Comma-separated .service units.
# MACHINARCHY_AGENT_SERVICE_ALLOWLIST=nginx.service,ssh.service
MACHINARCHY_AGENT_SYSTEMCTL_PATH=/usr/bin/systemctl
