# Machinarchy Agent configuration. Copy to .env (never commit it).
# See docs/configuration.md for every setting.

# production (default) requires an https:// server URL.
MACHINARCHY_ENVIRONMENT=development
MACHINARCHY_LOG_LEVEL=info

# Required: the controller server URL (the agent gateway). http:// only in development.
MACHINARCHY_AGENT_SERVER_URL=http://127.0.0.1:8443
# Optional: extra trusted CA for a private controller certificate.
# MACHINARCHY_AGENT_SERVER_CA_FILE=./secrets/ca.pem

# Required: the controller's base64 Ed25519 public key.
MACHINARCHY_AGENT_CONTROLLER_PUBLIC_KEY=

# Needed only for the first registration.
# MACHINARCHY_AGENT_ENROLLMENT_TOKEN_FILE=./secrets/enrollment.token

# Relative paths are resolved against the working directory.
MACHINARCHY_AGENT_STATE_FILE=./data/agent/state.json
