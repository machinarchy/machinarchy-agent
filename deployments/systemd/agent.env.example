# Machinarchy Agent configuration (/etc/machinarchy-agent/agent.env).
# Owned by root:machagent, mode 0640. Never commit real values.
MACHINARCHY_LOG_LEVEL=info
MACHINARCHY_AGENT_NAME=machinarchy-agent

# Required. Production requires tls:// endpoints.
MACHINARCHY_AGENT_NATS_URL=tls://nats.example.internal:4222
# Optional private CA and client certificate (mTLS).
# MACHINARCHY_AGENT_NATS_CA_FILE=/etc/machinarchy-agent/ca.pem
# MACHINARCHY_AGENT_NATS_CERT_FILE=/etc/machinarchy-agent/agent.pem
# MACHINARCHY_AGENT_NATS_KEY_FILE=/etc/machinarchy-agent/agent-key.pem

# Exactly one NATS authentication method (or the client certificate above).
MACHINARCHY_AGENT_NATS_CREDENTIALS_FILE=/etc/machinarchy-agent/agent.creds
# MACHINARCHY_AGENT_NATS_TOKEN=
# MACHINARCHY_AGENT_NATS_USERNAME=
# MACHINARCHY_AGENT_NATS_PASSWORD=

# Required. The controller's Ed25519 public key (base64). Commands and
# registration responses not signed by this key are rejected.
# MACHINARCHY_AGENT_CONTROLLER_PUBLIC_KEY=
# MACHINARCHY_AGENT_CONTROLLER_PUBLIC_KEY_FILE=/etc/machinarchy-agent/controller.pub

# One-time enrollment token, only needed until the first registration
# succeeds. Prefer a 0600 file owned by machagent and delete it afterwards.
# MACHINARCHY_AGENT_ENROLLMENT_TOKEN_FILE=/etc/machinarchy-agent/enrollment.token

# Execution limits.
# MACHINARCHY_AGENT_OPERATION_WORKERS=4
# MACHINARCHY_AGENT_OPERATION_QUEUE_SIZE=32
# MACHINARCHY_AGENT_OPERATION_TIMEOUT=5m
# MACHINARCHY_AGENT_OPERATION_MAX_OUTPUT_BYTES=65536
# MACHINARCHY_AGENT_SHUTDOWN_TIMEOUT=20s

# Service management is off unless explicitly enabled, and limited to exact
# unit names. Lifecycle actions (start/stop/restart) need a second opt-in and
# a host polkit rule for the machagent user.
MACHINARCHY_AGENT_SERVICE_MANAGEMENT_ENABLED=false
MACHINARCHY_AGENT_SERVICE_CONTROL_ENABLED=false
# MACHINARCHY_AGENT_SERVICE_ALLOWLIST=nginx.service,ssh.service
