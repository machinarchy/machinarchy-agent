# Machinarchy Agent production configuration.
# Edit this file before enabling the service. Keep it owned by root:machagent
# and mode 0640. Never put credentials in source control.
MACHINARCHY_ENVIRONMENT=production
MACHINARCHY_LOG_LEVEL=info
MACHINARCHY_AGENT_NAME=machinarchy-agent
MACHINARCHY_AGENT_STATE_FILE=/var/lib/machinarchy-agent/identity.json

# Required: use TLS for production NATS endpoints.
# MACHINARCHY_AGENT_NATS_URL=tls://nats.example.internal:4222

# Configure exactly one NATS authentication method when required.
# MACHINARCHY_AGENT_NATS_CREDENTIALS_FILE=/etc/machinarchy-agent/agent.creds
# MACHINARCHY_AGENT_NATS_TOKEN=
# MACHINARCHY_AGENT_NATS_USERNAME=
# MACHINARCHY_AGENT_NATS_PASSWORD=

# One-time enrollment credential. Remove after successful enrollment.
# MACHINARCHY_AGENT_ENROLLMENT_TOKEN=

# OS service management remains disabled unless explicitly configured.
MACHINARCHY_AGENT_SERVICE_MANAGEMENT_ENABLED=false
MACHINARCHY_AGENT_SERVICE_CONTROL_ENABLED=false
# MACHINARCHY_AGENT_SERVICE_ALLOWLIST=nginx.service,ssh.service
