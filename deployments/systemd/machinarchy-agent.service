[Unit]
Description=Machinarchy Agent
Documentation=https://github.com/machinarchy/machinarchy-agent
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=machagent
Group=machagent
ExecStart=/usr/local/bin/machinarchy-agent
Restart=on-failure
RestartSec=5s
TimeoutStopSec=20s
KillSignal=SIGTERM

EnvironmentFile=-/etc/machinarchy-agent/agent.env
Environment=MACHINARCHY_ENVIRONMENT=production
Environment=MACHINARCHY_AGENT_STATE_FILE=/var/lib/machinarchy-agent/identity.json

StateDirectory=machinarchy-agent
StateDirectoryMode=0700
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
LockPersonality=true
RestrictSUIDSGID=true
RestrictRealtime=true
CapabilityBoundingSet=
AmbientCapabilities=

[Install]
WantedBy=multi-user.target
