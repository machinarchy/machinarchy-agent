[Unit]
Description=Machinarchy Agent
Documentation=https://github.com/machinarchy/machinarchy-agent
Wants=network-online.target
After=network-online.target
StartLimitIntervalSec=5min
StartLimitBurst=5

[Service]
Type=simple
User=machagent
Group=machagent
ExecStart=/usr/local/bin/machinarchy-agent
Restart=on-failure
RestartSec=5s
TimeoutStopSec=25s
KillSignal=SIGTERM

EnvironmentFile=-/etc/machinarchy-agent/agent.env
Environment=MACHINARCHY_ENVIRONMENT=production
Environment=MACHINARCHY_AGENT_STATE_FILE=/var/lib/machinarchy-agent/identity.json
Environment=HOME=/var/lib/machinarchy-agent
WorkingDirectory=/var/lib/machinarchy-agent

StateDirectory=machinarchy-agent
StateDirectoryMode=0700
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
LockPersonality=true
RestrictSUIDSGID=true
RestrictRealtime=true
CapabilityBoundingSet=
AmbientCapabilities=
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
SystemCallArchitectures=native
ReadWritePaths=/var/lib/machinarchy-agent

[Install]
WantedBy=multi-user.target
